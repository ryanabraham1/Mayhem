              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endt"
        },
        "recoveryPolicy": {
          "default": "fireAtJoin",
          "enum": [
            "fireAtJoin",
            "fireImmediately",
            "skip"
          ],
          "title": "Recoverypolicy",
          "type": "string"
        },
        "mustHit": {
          "default": false,
          "title": "Musthit",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "command",
        "t"
      ],
      "title": "EventOut",
      "type": "object"
    },
    "Field_": {
      "description": "A field definition. Named Field_ to avoid clashing with pydantic.Field.",
      "properties": {
        "id": {
          "default": "blank",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "Blank field",
          "title": "Name",
          "type": "string"
        },
        "length": {
          "default": 16.541,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "default": 8.0692,
          "title": "Width",
          "type": "number"
        },
        "symmetry": {
          "default": "rotational",
          "enum": [
            "mirror",
            "rotational"
          ],
          "title": "Symmetry",
          "type": "string"
        },
        "wallMargin": {
          "default": 0.02,
          "title": "Wallmargin",
          "type": "number"
        },
        "obstacles": {
          "items": {
            "$ref": "#/$defs/Obstacle"
          },
          "title": "Obstacles",
          "type": "array"
        },
        "decorations": {
          "items": {
            "$ref": "#/$defs/Decoration"
          },
          "title": "Decorations",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Field",
      "type": "object"
    },
    "FuelSimConfig": {
      "description": "Settings for the app's fuel playback sim (our robot's intake plus other robots' autos).",
      "properties": {
        "intakeRate": {
          "default": 10.0,
          "description": "Fuel per second our intake can take in",
          "minimum": 0,
          "title": "Intakerate",
          "type": "number"
        },
        "capacity": {
          "default": 0,
          "description": "Fuel our robot can hold; 0 = no limit",
          "minimum": 0,
          "title": "Capacity",
          "type": "integer"
        },
        "robots": {
          "items": {
            "$ref": "#/$defs/SimRobot"
          },
          "title": "Robots",
          "type": "array"
        }
      },
      "title": "FuelSimConfig",
      "type": "object"
    },
    "Intake": {
      "description": "A mechanism that reaches past one bumper side when deployed (e.g. an over-the-bumper intake).\n\nIt only counts for collisions where an intakeExtended constraint says it is out.",
      "properties": {
        "side": {
          "default": "front",
          "enum": [
            "front",
            "back",
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        },
        "extension": {
          "default": 0.3,
          "description": "How far it reaches past the bumper edge [m]",
          "minimum": 0,
          "title": "Extension",
          "type": "number"
        },
        "width": {
          "default": 0.0,
          "description": "Width along the bumper side [m]; 0 = the whole side",
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "description": "Shift of its center along the side [m]: toward robot left on the front/back, toward robot front on the left/right. Ignored when width is 0.",
          "title": "Offset",
          "type": "number"
        }
      },
      "title": "Intake",
      "type": "object"
    },
    "IntakeExtended": {
      "description": "The robot's intake (robot config) is deployed over this scope.\n\nObstacle, wall and keep-in checks use the bumper plus the intake there. The covered time\nspans are exported so MayhemLib can tell robot code when to deploy it.",
      "properties": {
        "type": {
          "const": "intakeExtended",
          "default": "intakeExtended",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "IntakeExtended",
      "type": "object"
    },
    "IntakeSpan": {
      "description": "A stretch of the trajectory where the intake is planned to be extended.",
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "endT": {
          "title": "Endt",
          "type": "number"
        }
      },
      "required": [
        "t",
        "endT"
      ],
      "title": "IntakeSpan",
      "type": "object"
    },
    "Issue": {
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
