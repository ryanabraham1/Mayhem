{
  "$defs": {
    "Bumper": {
      "description": "Bumper outline as distances from robot center (always positive).",
      "properties": {
        "front": {
          "default": 0.45,
          "title": "Front",
          "type": "number"
        },
        "back": {
          "default": 0.45,
          "title": "Back",
          "type": "number"
        },
        "left": {
          "default": 0.45,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "default": 0.45,
          "title": "Right",
          "type": "number"
        }
      },
      "title": "Bumper",
      "type": "object"
    },
    "Constraint": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "default": {
            "kind": "range",
            "from": 0,
            "to": 0,
            "region": []
          }
        },
        "data": {
          "discriminator": {
            "mapping": {
              "intakeExtended": "#/$defs/IntakeExtended",
              "keepIn": "#/$defs/KeepIn",
              "keepOut": "#/$defs/KeepOut",
              "maxAcceleration": "#/$defs/MaxAcceleration",
              "maxAngularVelocity": "#/$defs/MaxAngularVelocity",
              "maxVelocity": "#/$defs/MaxVelocity",
              "pointAt": "#/$defs/PointAt",
              "roughTerrain": "#/$defs/RoughTerrain",
              "straightLine": "#/$defs/StraightLine"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MaxVelocity"
            },
            {
              "$ref": "#/$defs/MaxAcceleration"
            },
            {
              "$ref": "#/$defs/MaxAngularVelocity"
            },
            {
              "$ref": "#/$defs/PointAt"
            },
            {
              "$ref": "#/$defs/KeepIn"
            },
            {
              "$ref": "#/$defs/KeepOut"
            },
            {
              "$ref": "#/$defs/StraightLine"
            },
            {
              "$ref": "#/$defs/RoughTerrain"
            },
            {
              "$ref": "#/$defs/IntakeExtended"
            }
          ],
          "title": "Data"
        }
      },
      "required": [
        "id",
        "data"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Decoration": {
      "description": "Non-obstacle field artwork (tape, zones, game pieces) drawn by the app.",
      "properties": {
        "kind": {
          "default": "polygon",
          "enum": [
            "polygon",
            "line",
            "circle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "center": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "default": 0.1,
          "title": "Radius",
          "type": "number"
        },
        "style": {
          "default": "tape",
          "enum": [
            "blueZone",
            "redZone",
            "tape",
            "blueTape",
            "redTape",
            "fuel",
            "structure",
            "blue",
            "red"
          ],
          "title": "Style",
          "type": "string"
        },
        "width": {
          "default": 0.05,
          "title": "Width",
          "type": "number"
        }
      },
      "title": "Decoration",
      "type": "object"
    },
    "EventOut": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
