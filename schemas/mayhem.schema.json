        },
        "data": {
          "discriminator": {
            "mapping": {
              "keepIn": "#/$defs/KeepIn",
              "keepOut": "#/$defs/KeepOut",
              "maxAcceleration": "#/$defs/MaxAcceleration",
              "maxAngularVelocity": "#/$defs/MaxAngularVelocity",
              "maxVelocity": "#/$defs/MaxVelocity",
              "pointAt": "#/$defs/PointAt"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MaxVelocity"
            },
            {
              "$ref": "#/$defs/MaxAcceleration"
            },
            {
              "$ref": "#/$defs/MaxAngularVelocity"
            },
            {
              "$ref": "#/$defs/PointAt"
            },
            {
              "$ref": "#/$defs/KeepIn"
            },
            {
              "$ref": "#/$defs/KeepOut"
            }
          ],
          "title": "Data"
        }
      },
      "required": [
        "id",
        "data"
      ],
      "title": "Constraint",
      "type": "object"
    },
