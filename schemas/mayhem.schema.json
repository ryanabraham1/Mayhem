          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
