{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "app", "dev"],
      "port": 5173
    },
    {
      "name": "app-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "app", "exec", "vite", "--port", "5183"],
      "port": 5183,
      "autoPort": false
    },
    {
      "name": "solver",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "solver", "run", "mayhem-solver", "serve", "--ws", "8765"],
      "port": 8765,
      "autoPort": false
    }
  ]
}
