diff --git a/scripts/advantagescope-bridge.js b/scripts/advantagescope-bridge.js
new file mode 100644
index 0000000..88d7f27
--- /dev/null
+++ b/scripts/advantagescope-bridge.js
@@ -0,0 +1,31 @@
+// Team integration, appended to the pinned upstream module (X = sendMessage, W = hubPort).
+// Accept only this window's same-origin parent, and never accept a remote log URL.
+let mayhemReady = false;
+const mayhemFiles = new Map();
+function mayhemScopeReady() {
+  mayhemReady = true;
+  window.parent.postMessage({ type: 'team-scope-ready' }, location.origin);
+}
+async function mayhemScopeFetch(name, folder) {
+  const data = mayhemFiles.get(name);
+  if (data) {
+    mayhemFiles.delete(name);
+    return new Response(data);
+  }
+  return fetch(`logs/${encodeURIComponent(name)}?folder=${encodeURIComponent(folder)}`);
+}
+window.addEventListener('message', (event) => {
+  if (event.origin !== location.origin || event.source !== window.parent || window.parent === window) return;
+  if (event.data?.type === 'team-scope-ping') {
+    if (mayhemReady) mayhemScopeReady();
+    return;
+  }
+  if (!mayhemReady || event.data?.type !== 'team-scope-open') return;
+  const { bytes, name } = event.data;
+  if (!(bytes instanceof ArrayBuffer) || bytes.byteLength > 250 * 1024 * 1024 || bytes.byteLength < 12 || typeof name !== 'string' || !name.toLowerCase().endsWith('.wpilog')) return;
+  mayhemFiles.clear();
+  const safeName = name.replace(/[\\/\x00-\x1f]/g, '_').slice(-180);
+  mayhemFiles.set(safeName, bytes);
+  X(W, 'open-files', { files: [safeName], merge: false });
+  window.parent.postMessage({ type: 'team-scope-opened', name: safeName }, location.origin);
+});
diff --git a/scripts/vendor-advantagescope.mjs b/scripts/vendor-advantagescope.mjs
new file mode 100644
index 0000000..2e400b3
--- /dev/null
+++ b/scripts/vendor-advantagescope.mjs
@@ -0,0 +1,61 @@
+/** Pinned upstream binary; no build of a replacement viewer. See docs/ADVANTAGESCOPE.md. */
+import { createHash } from 'node:crypto';
+import { mkdtemp, readFile, writeFile, mkdir, cp, rm, readdir } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+const version = 'v27.0.0-alpha-6';
+const digest = '2836019cd1f31be79459df1c83eb2cb26a3fe5dbd3f5820a898c2fe2acc98890';
+const target = path.resolve('public/advantagescope');
+const bridge = await readFile('scripts/advantagescope-bridge.js', 'utf8');
+const stamp = version + ':' + createHash('sha256').update(bridge).update(await readFile(new URL(import.meta.url))).digest('hex');
+if (await readFile(path.join(target, '.version'), 'utf8').catch(() => '') === stamp) process.exit(0);
+const temp = await mkdtemp(path.join(tmpdir(), 'team-advantagescope-'));
+try {
+  const local = process.env.ADVANTAGESCOPE_IPK;
+  const archive = local ? await readFile(local) : Buffer.from(await (await fetch(`https://github.com/Mechanical-Advantage/AdvantageScope/releases/download/${version}/advantagescope-lite-${version}.ipk`)).arrayBuffer());
+  if (createHash('sha256').update(archive).digest('hex') !== digest) throw new Error('AdvantageScope artifact checksum mismatch');
+  if (archive.subarray(0, 8).toString() !== '!<arch>\n') throw new Error('Invalid package');
+  let data;
+  for (let offset = 8; offset < archive.length;) {
+    const header = archive.subarray(offset, offset + 60);
+    const size = Number(header.subarray(48, 58).toString().trim());
+    if (!Number.isSafeInteger(size) || size <= 0) throw new Error('Invalid archive size');
+    if (header.subarray(0, 16).toString().trim().replace(/\/$/, '') === 'data.tar.gz') data = archive.subarray(offset + 60, offset + 60 + size);
+    offset += 60 + size + size % 2;
+  }
+  if (!data) throw new Error('Missing package data');
+  await writeFile(path.join(temp, 'data.tar.gz'), data);
+  execFileSync('tar', ['xzf', path.join(temp, 'data.tar.gz'), '-C', temp]);
+  const root = path.join(temp, 'usr/local/bin/advantagescope-lite');
+  await rm(target, { recursive: true, force: true });
+  await cp(path.join(root, 'static'), target, { recursive: true });
+  for (const file of ['LICENSE', 'ThirdPartyLicenses.txt']) await cp(path.join(root, file), path.join(target, file));
+  // Python's on-robot asset index is replaced by equivalent static JSON.
+  const index = {};
+  async function visit(dir, prefix = '') {
+    for (const entry of await readdir(dir, { withFileTypes: true })) {
+      const key = prefix + entry.name, full = path.join(dir, entry.name);
+      if (entry.isDirectory()) await visit(full, key + '/');
+      else index[key] = key.endsWith('config.json') ? JSON.parse(await readFile(full, 'utf8')) : null;
+    }
+  }
+  await visit(path.join(target, 'bundledAssets'));
+  await writeFile(path.join(target, 'asset-index.json'), JSON.stringify(index));
+  await cp(path.join(target, 'bundledAssets'), path.join(target, 'assets'), { recursive: true });
+  await rm(path.join(target, 'bundledAssets'), { recursive: true });
+  let main = await readFile(path.join(target, 'bundles/main.js'), 'utf8');
+  function replaceOnce(before, after) {
+    if (main.split(before).length !== 2) throw new Error('Upstream bridge anchor changed: ' + before);
+    main = main.replace(before, after);
+  }
+  replaceOnce('window.location.pathname', '"/advantagescope/"');
+  replaceOnce('X(W,`show-when-ready`)', 'X(W,`show-when-ready`),mayhemScopeReady()');
+  replaceOnce('fetch(`logs/${encodeURIComponent(n)}?folder=${encodeURIComponent(r.remotePath)}`)', 'mayhemScopeFetch(n,r.remotePath)');
+  await writeFile(path.join(target, 'bundles/main.js'), main + '\n' + bridge);
+  // The release expects a slash-terminated base, supplied by index.html + <base>.
+  const html = await readFile(path.join(target, 'index.html'), 'utf8');
+  await writeFile(path.join(target, 'index.html'), html.replace('<head>', '<head><base href="/advantagescope/">'));
+  await writeFile(path.join(target, '.version'), stamp);
+  console.log('Prepared official AdvantageScope Lite ' + version);
+} finally { await rm(temp, { recursive: true, force: true }); }
diff --git a/supabase/migrations/20261110223420_robot_log_library.sql b/supabase/migrations/20261110223420_robot_log_library.sql
new file mode 100644
index 0000000..fcac445
--- /dev/null
+++ b/supabase/migrations/20261110223420_robot_log_library.sql
@@ -0,0 +1,18 @@
+-- Shared team-code authorization is enforced in server routes. Neither the
+-- browser anon key nor a regular Supabase user may access this table/bucket.
+begin;
+create table if not exists public.robot_logs (
+  sha256 text primary key check (sha256 ~ '^[a-f0-9]{64}$'),
+  name text not null check (length(name) between 1 and 200),
+  size bigint not null check (size between 12 and 262144000),
+  status text not null default 'pending' check (status in ('pending', 'ready')),
+  created_at timestamptz not null default now()
+);
+alter table public.robot_logs enable row level security;
+revoke all on public.robot_logs from anon, authenticated;
+grant select, insert, update, delete on public.robot_logs to service_role;
+create index if not exists robot_logs_ready_created_idx on public.robot_logs (created_at desc) where status = 'ready';
+insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+values ('robot-logs', 'robot-logs', false, 262144000, array['application/octet-stream'])
+on conflict (id) do nothing;
+commit;
diff --git a/tests/advantagescope.test.mjs b/tests/advantagescope.test.mjs
new file mode 100644
index 0000000..63fd1f5
--- /dev/null
+++ b/tests/advantagescope.test.mjs
@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+
+test('scope accepts only parent-origin byte handoffs after readiness, without uploading a local file', async () => {
+  const origin = 'https://3256tools.vercel.app';
+  const sent = [], opened = [], requests = [], listeners = {};
+  const parent = { postMessage: value => sent.push(value) };
+  const window = { parent, addEventListener: (type, handler) => listeners[type] = handler };
+  const context = vm.createContext({ window, location: { origin }, ArrayBuffer, Response, Map, X: (...args) => opened.push(args), W: 'hub', fetch: url => { requests.push(url); return new Response('remote'); } });
+  vm.runInContext(readFileSync('scripts/advantagescope-bridge.js', 'utf8'), context);
+  const bytes = new ArrayBuffer(20);
+  const receive = (source = parent, from = origin) => listeners.message({ source, origin: from, data: { type: 'team-scope-open', name: '../match.wpilog', bytes } });
+  receive(); assert.equal(opened.length, 0);
+  vm.runInContext('mayhemScopeReady()', context);
+  receive({}, origin); receive(parent, 'https://evil.example'); assert.equal(opened.length, 0);
+  receive(); assert.equal(opened.length, 1); assert.equal(opened[0][1], 'open-files');
+  assert.equal(opened[0][2].files[0], '.._match.wpilog');
+  const response = await vm.runInContext('mayhemScopeFetch(".._match.wpilog", "")', context);
+  assert.equal((await response.arrayBuffer()).byteLength, 20);
+  assert.equal(requests.length, 0);
+  assert.equal(sent.at(-1).type, 'team-scope-opened');
+});
diff --git a/tests/robot-logs.test.mjs b/tests/robot-logs.test.mjs
