+import "server-only";
+import { createHash, timingSafeEqual } from "node:crypto";
+import { isAuthed } from "@/lib/auth";
+/** Device token grants upload only. Team cookies are still required to browse/download. */
+export async function mayUploadLogs(request: Request): Promise<boolean> {
+  const authorization = request.headers.get("authorization") ?? "";
+  const expected = process.env.ROBOT_LOG_UPLOAD_TOKEN;
+  if (
+    authorization.startsWith("Bearer ") &&
+    expected &&
+    expected.length >= 32
+  ) {
+    const digest = (s: string) => createHash("sha256").update(s).digest();
+    if (timingSafeEqual(digest(authorization.slice(7)), digest(expected)))
+      return true;
+  }
+  const origin = request.headers.get("origin");
+  if (origin && origin !== new URL(request.url).origin) return false;
+  return isAuthed();
+}
+export async function smallJSON(
+  request: Request,
+): Promise<Record<string, unknown>> {
+  const reader = request.body?.getReader();
+  if (!reader) throw new Error("Missing request body");
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.length;
+      if (size > 8192) {
+        await reader.cancel();
+        throw new Error("Request metadata exceeds 8 KB");
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const input: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+  if (!input || typeof input !== "object" || Array.isArray(input))
+    throw new Error("Expected JSON metadata");
+  return input as Record<string, unknown>;
+}
+export const LOG_BUCKET = "robot-logs";
+export const MAX_LOG_BYTES = 250 * 1024 * 1024;
+export const validHash = (value: unknown): value is string =>
+  typeof value === "string" && /^[a-f0-9]{64}$/.test(value);
+export const logPath = (hash: string) => `${hash}.wpilog`;
diff --git a/lib/robot-logs/core/analysis.ts b/lib/robot-logs/core/analysis.ts
new file mode 100644
index 0000000..0a96789
--- /dev/null
+++ b/lib/robot-logs/core/analysis.ts
@@ -0,0 +1,333 @@
+// Synced from Mayhem. Update with scripts/sync-team-log-core.mjs in that repository.
+export interface Sample {
+  time: number;
+  value: number | boolean | string;
+}
+export interface Channel {
+  name: string;
+  type: string;
+  samples: Sample[];
+}
+export interface Recording {
+  name: string;
+  duration: number;
+  channels: Channel[];
+  warnings: string[];
+}
+export interface Finding {
+  id: string;
+  severity: "error" | "warning";
+  title: string;
+  detail: string;
+  start: number;
+  end: number;
+  channel: string;
+}
+export interface PowerMapping {
+  voltage?: string;
+  current?: string;
+  brownout?: string;
+}
+export interface Analysis {
+  findings: Finding[];
+  coverage: string[];
+  mapping: PowerMapping;
+  power: {
+    minVoltage?: number;
+    peakCurrent?: number;
+    energyWh?: number;
+    averagePower?: number;
+  };
+}
+export function suggestMapping(channels: Channel[]): PowerMapping {
+  const names = channels.map((c) => c.name);
+  return {
+    voltage: names.find((n) =>
+      /(?:batteryvoltage|inputvoltage|powerdistribution\/voltage|pdh\/voltage|pdp\/voltage)$/i.test(
+        n,
+      ),
+    ),
+    current: names.find((n) =>
+      /(?:totalcurrent|powerdistribution\/totalcurrent|pdh\/current|pdp\/current)$/i.test(
+        n,
+      ),
+    ),
+    brownout: names.find((n) =>
+      /(?:brownedout|isbrownedout|brownout)$/i.test(n),
+    ),
+  };
+}
+export function analyze(
+  recording: Recording,
+  supplied?: PowerMapping,
+): Analysis {
+  const mapping = supplied ?? suggestMapping(recording.channels);
+  const channels = new Map(recording.channels.map((c) => [c.name, c]));
+  const findings: Finding[] = [],
+    coverage: string[] = [];
+  const voltage = channels.get(mapping.voltage ?? ""),
+    current = channels.get(mapping.current ?? ""),
+    brownout = channels.get(mapping.brownout ?? "");
+  const excursions = (
+    channel: Channel,
+    test: (v: Sample["value"]) => boolean,
+    title: string,
+    detail: string,
+    severity: Finding["severity"],
+    minDuration = 0,
+  ) => {
+    let start: number | undefined;
+    const close = (end: number) => {
+      if (start !== undefined && end - start >= minDuration)
+        findings.push({
+          id: `${channel.name}:${start}`,
+          severity,
+          title,
+          detail,
+          start,
+          end,
+          channel: channel.name,
+        });
+      start = undefined;
+    };
+    for (const s of channel.samples) {
+      if (test(s.value)) start ??= s.time;
+      else if (start !== undefined) close(s.time);
+    }
+    if (start !== undefined) close(recording.duration);
+  };
+  const numbers = (c?: Channel) =>
+    c?.samples.filter(
+      (s): s is Sample & { value: number } =>
+        typeof s.value === "number" && Number.isFinite(s.value),
+    ) ?? [];
+  const v = numbers(voltage),
+    a = numbers(current);
+  if (!v.length)
+    coverage.push(
+      "Battery voltage missing: voltage sag and power calculations unavailable.",
+    );
+  else
+    excursions(
+      voltage!,
+      (n) => typeof n === "number" && n < 9,
+      "Low battery voltage",
+      "Measured battery voltage below 9 V for at least 100 ms. Inspect simultaneous current and mechanism activity; this alone does not identify the cause.",
+      "warning",
+      0.1,
+    );
+  if (!a.length)
+    coverage.push(
+      "Total current missing: total load and energy calculations unavailable.",
+    );
+  else
+    excursions(
+      current!,
+      (n) => typeof n === "number" && n > 180,
+      "Sustained high current",
+      "Measured total current above 180 A for at least 250 ms. Threshold is a starting diagnostic, not a breaker model.",
+      "warning",
+      0.25,
+    );
+  if (brownout)
+    excursions(
+      brownout,
+      (n) => n === true,
+      "Robot reported a brownout",
+      "The recorded brownout flag was asserted.",
+      "error",
+    );
+  else
+    coverage.push(
+      "Brownout flag missing: low voltage is not proof that the robot browned out.",
+    );
+  let diagnosticChannels = 0;
+  for (const channel of recording.channels) {
+    if (
+      /(?:LoopTimeMs|LoopDurationMs|LoopTimeMilliseconds|LoopPeriodMs)$/i.test(channel.name)
+    ) {
+      diagnosticChannels++;
+      const isPeriod = /LoopPeriodMs$/i.test(channel.name);
+      excursions(
+        channel,
+        (v) => typeof v === "number" && v > (isPeriod ? 25 : 20),
+        isPeriod ? "Control loop period over 25 ms" : "Control loop over 20 ms",
+        isPeriod
+          ? "Recorded loop start-to-start period exceeds 25 ms for at least 100 ms. This allows ordinary jitter around a 20 ms loop; compare with the robot’s configured period."
+          : "Recorded loop duration exceeds 20 ms for at least 100 ms. Compare with the robot’s configured loop period; this rule only accepts signals explicitly named in milliseconds.",
+        "warning",
+        0.1,
+      );
+    }
+    if (
+      channel.type === "boolean" &&
+      /(?:HasFault|Faulted|ResetOccurred|HasReset|TimedOut)$/i.test(
+        channel.name,
+      )
+    ) {
+      diagnosticChannels++;
+      excursions(
+        channel,
+        (v) => v === true,
+        "Robot reported a fault or timeout",
+        `The recorded flag ${channel.name} was asserted. Inspect that device or action at this time.`,
+        "error",
+      );
+    }
+    if (
+      channel.type === "boolean" &&
+      /(?:Connected|IsConnected)$/i.test(channel.name)
+    ) {
+      diagnosticChannels++;
+      excursions(
+        channel,
+        (v) => v === false,
+        "Device reported disconnected",
+        `The recorded connection flag ${channel.name} was false for at least 250 ms.`,
+        "warning",
+        0.25,
+      );
+    }
+    if (channel.type === "string" && /(?:^|\/)(?:state|currentstate)$/i.test(channel.name)) {
+      diagnosticChannels++;
+      const changes = channel.samples.filter(
+        (s, i) => i === 0 || s.value !== channel.samples[i - 1].value,
+      );
+      let left = 0,
+        lastEnd = -Infinity;
+      for (let right = 0; right < changes.length; right++) {
+        while (changes[right].time - changes[left].time > 1) left++;
+        if (right - left >= 10 && changes[left].time > lastEnd) {
+          const start = changes[left].time,
+            end = changes[right].time;
+          findings.push({
+            id: `chatter:${channel.name}:${start}`,
+            severity: "warning",
+            title: "Rapid state switching",
+            detail:
+              "At least ten state changes occurred within one second. Inspect inputs and transition guards for chatter.",
+            start,
+            end,
+            channel: channel.name,
+          });
+          lastEnd = end;
+        }
+      }
+    }
+  }
+  if (!diagnosticChannels)
+    coverage.push(
+      "No recognized loop, device-fault, connection, or state-machine signals were recorded. General robot diagnostics are limited.",
+    );
+  coverage.push(
+    "Rules flag recorded symptoms, not proven root causes. Custom mechanisms need suitable signals and team-specific checks.",
+  );
+  let energy = 0,
+    covered = 0;
+  // Zero-order-hold integration over both streams, restricted to their common time span.
+  if (v.length && a.length) {
+    const start = Math.max(v[0].time, a[0].time);
+    const end = Math.min(
+      recording.duration,
+      v[v.length - 1].time,
+      a[a.length - 1].time,
+    );
+    let vi = 0,
+      ai = 0,
+      time = start;
+    while (vi + 1 < v.length && v[vi + 1].time <= time) vi++;
+    while (ai + 1 < a.length && a[ai + 1].time <= time) ai++;
+    while (time < end) {
+      const next = Math.min(
+        v[vi + 1]?.time ?? end,
+        a[ai + 1]?.time ?? end,
+        end,
+      );
+      if (next > time) {
+        energy += Math.max(0, v[vi].value * a[ai].value) * (next - time);
+        covered += next - time;
+      }
+      time = next;
+      while (vi + 1 < v.length && v[vi + 1].time <= time) vi++;
+      while (ai + 1 < a.length && a[ai + 1].time <= time) ai++;
+    }
+  }
+  let minVoltage: number | undefined, peakCurrent: number | undefined;
+  for (const s of v) minVoltage = Math.min(minVoltage ?? Infinity, s.value);
+  for (const s of a) peakCurrent = Math.max(peakCurrent ?? -Infinity, s.value);
+  return {
+    mapping,
+    findings: findings.sort((a, b) => a.start - b.start),
+    coverage,
+    power: {
+      minVoltage,
+      peakCurrent,
+      energyWh: covered > 0 ? energy / 3600 : undefined,
+      averagePower: covered > 0 ? energy / covered : undefined,
+    },
+  };
+}
+export function parseRecordingJSON(text: string): Recording {
+  const input = JSON.parse(text);
+  if (
+    !input ||
+    typeof input.name !== "string" ||
+    !Number.isFinite(input.duration) ||
+    input.duration < 0 ||
+    !Array.isArray(input.channels)
+  )
+    throw new Error("Expected a recording with name, duration, and channels.");
+  const names = new Set<string>();
+  for (const channel of input.channels) {
+    if (
+      !channel ||
+      typeof channel.name !== "string" ||
+      typeof channel.type !== "string" ||
+      names.has(channel.name) ||
+      !Array.isArray(channel.samples)
+    )
+      throw new Error(
+        "Channel names must be unique and samples must be arrays.",
+      );
+    names.add(channel.name);
+    let last = -Infinity;
+    for (const sample of channel.samples) {
+      if (
+        !sample ||
+        !Number.isFinite(sample.time) ||
+        sample.time < 0 ||
+        sample.time > input.duration ||
+        sample.time < last ||
+        !["number", "boolean", "string"].includes(typeof sample.value) ||
+        (typeof sample.value === "number" && !Number.isFinite(sample.value))
+      )
+        throw new Error("Invalid or unordered channel sample.");
+      last = sample.time;
+    }
+  }
+  if (
+    input.warnings !== undefined &&
+    (!Array.isArray(input.warnings) ||
+      input.warnings.some((w: unknown) => typeof w !== "string"))
+  )
+    throw new Error("Recording warnings must be text.");
+  return {
+    ...input,
+    warnings: Array.isArray(input.warnings) ? input.warnings : [],
+  };
+}
+export function valueAt(
+  channel: Channel | undefined,
+  time: number,
+): Sample["value"] | undefined {
+  if (!channel?.samples.length || channel.samples[0].time > time)
+    return undefined;
+  let lo = 0,
+    hi = channel.samples.length - 1;
+  while (lo < hi) {
+    const mid = Math.ceil((lo + hi) / 2);
+    if (channel.samples[mid].time <= time) lo = mid;
+    else hi = mid - 1;
+  }
+  return channel.samples[lo].value;
+}
diff --git a/lib/robot-logs/core/plot.ts b/lib/robot-logs/core/plot.ts
new file mode 100644
index 0000000..dcb1832
--- /dev/null
+++ b/lib/robot-logs/core/plot.ts
@@ -0,0 +1,37 @@
+// Synced from Mayhem. Update with scripts/sync-team-log-core.mjs in that repository.
+import type { Channel, Sample } from "./analysis";
+/** Preserve spikes and the full time span while bounding SVG work. Raw data stays intact. */
+export function plotSeries(channel: Channel | undefined, buckets = 600) {
+  const numeric =
+    channel?.samples.filter(
+      (s): s is Sample & { value: number } =>
+        typeof s.value === "number" && Number.isFinite(s.value),
+    ) ?? [];
+  if (!numeric.length) return { samples: [] as Sample[], min: 0, max: 0 };
+  const size = Math.max(
+    1,
+    Math.ceil(numeric.length / Math.max(1, Math.floor(buckets))),
+  );
+  let min = Infinity,
+    max = -Infinity;
+  const samples: Sample[] = [numeric[0]];
+  for (let start = 0; start < numeric.length; start += size) {
+    const end = Math.min(numeric.length, start + size);
+    let low = start,
+      high = start;
+    for (let i = start; i < end; i++) {
+      if (numeric[i].value < numeric[low].value) low = i;
+      if (numeric[i].value > numeric[high].value) high = i;
+    }
+    min = Math.min(min, numeric[low].value);
+    max = Math.max(max, numeric[high].value);
+    for (const index of low < high
+      ? [low, high]
+      : low === high
+        ? [low]
+        : [high, low])
+      if (samples.at(-1) !== numeric[index]) samples.push(numeric[index]);
+  }
+  if (samples.at(-1) !== numeric.at(-1)) samples.push(numeric.at(-1)!);
+  return { samples, min, max };
+}
diff --git a/lib/robot-logs/core/wpilog.ts b/lib/robot-logs/core/wpilog.ts
new file mode 100644
index 0000000..9b8864e
--- /dev/null
+++ b/lib/robot-logs/core/wpilog.ts
@@ -0,0 +1,218 @@
+// Synced from Mayhem. Update with scripts/sync-team-log-core.mjs in that repository.
+import type { Channel, Recording, Sample } from "./analysis";
+/** WPILOG 1.0 reader. Binary structures remain visible as unsupported channels.
+ * Spec: allwpilib v2026.2.2/wpiutil/doc/datalog.adoc. */
+export function parseWPILog(buffer: ArrayBuffer, name: string): Recording {
+  const bytes = new Uint8Array(buffer),
+    view = new DataView(buffer),
+    decoder = new TextDecoder();
+  if (bytes.length < 12 || decoder.decode(bytes.subarray(0, 6)) !== "WPILOG")
+    throw new Error("This file is not a WPILOG recording.");
+  const version = view.getUint16(6, true);
+  if (version !== 0x0100)
+    throw new Error(
+      `Unsupported WPILOG version 0x${version.toString(16)}. Expected version 1.0.`,
+    );
+  let offset = 12 + view.getUint32(8, true);
+  if (offset > bytes.length) throw new Error("Truncated WPILOG header.");
+  const active = new Map<number, Channel>(),
+    channels: Channel[] = [],
+    derivedChannels = new Map<string, Channel>(),
+    warnings = new Set<string>();
+  let minTime = Infinity,
+    maxTime = 0,
+    sampleCount = 0;
+  const uint = (length: number) => {
+    if (offset + length > bytes.length)
+      throw new Error("Truncated record header.");
+    let result = 0;
+    for (let i = 0; i < length; i++) result += bytes[offset++] * 2 ** (8 * i);
+    if (!Number.isSafeInteger(result))
+      throw new Error("Timestamp exceeds supported integer precision.");
+    return result;
+  };
+  while (offset < bytes.length) {
+    const flags = bytes[offset++];
+    if (flags & 0x80) throw new Error("Invalid WPILOG record header.");
+    const id = uint((flags & 3) + 1),
+      size = uint(((flags >> 2) & 3) + 1),
+      time = uint(((flags >> 4) & 7) + 1) / 1e6;
+    const end = offset + size;
+    if (end > bytes.length)
+      throw new Error(
+        "Recording ends in an incomplete record. Wait for the robot to finish writing, then download again.",
+      );
+    if (id === 0 && size) {
+      const control = bytes[offset++];
+      if (control === 0) {
+        if (offset + 4 > end) throw new Error("Invalid start record.");
+        const entry = view.getUint32(offset, true);
+        offset += 4;
+        const string = () => {
+          if (offset + 4 > end) throw new Error("Invalid entry string.");
+          const length = view.getUint32(offset, true);
+          offset += 4;
+          if (offset + length > end) throw new Error("Truncated entry string.");
+          const text = decoder.decode(bytes.subarray(offset, offset + length));
+          offset += length;
+          return text;
+        };
+        const entryName = string(),
+          type = string();
+        string();
+        const existing = channels.find(
+          (c) => c.name === entryName && c.type === type,
+        );
+        const duplicate = channels.some(
+          (c) => c.name === entryName && c.type !== type,
+        );
+        const channel = existing ?? {
+          name: duplicate ? `${entryName} (${type})` : entryName,
+          type,
+          samples: [],
+        };
+        if (!existing) channels.push(channel);
+        active.set(entry, channel);
+      } else if (control === 1) {
+        if (offset + 4 > end) throw new Error("Invalid finish record.");
+        active.delete(view.getUint32(offset, true));
+      }
+    } else if (id !== 0) {
+      const channel = active.get(id);
+      if (!channel)
+        warnings.add(
+          "Some records referenced unknown entry IDs and were skipped.",
+        );
+      else {
+        minTime = Math.min(minTime, time);
+        maxTime = Math.max(maxTime, time);
+        const append = (target: Channel, value: Sample["value"]) => {
+          if (typeof value === "number" && !Number.isFinite(value)) return;
+          if (++sampleCount > 2_000_000)
+            throw new Error(
+              "This recording exceeds the current 2 million sample limit. No partial analysis was produced.",
+            );
+          target.samples.push({ time, value });
+        };
+        const derived = (suffix: string, value: number | boolean) => {
+          const name = `${channel.name}/${suffix}`;
+          let target = derivedChannels.get(name);
+          if (!target) {
+            target = {
+              name,
+              type: typeof value === "number" ? "double" : "boolean",
+              samples: [],
+            };
+            channels.push(target);
+            derivedChannels.set(name, target);
+          }
+          append(target, value);
+        };
+        let value: Sample["value"] | undefined;
+        const scalarSizes: Record<string, number> = {
+          boolean: 1,
+          double: 8,
+          float: 4,
+          int64: 8,
+        };
+        if (scalarSizes[channel.type] && size !== scalarSizes[channel.type])
+          throw new Error(`Invalid scalar payload size for ${channel.name}.`);
+        const arrays: Record<string, number> = {
+          "double[]": 8,
+          "float[]": 4,
+          "int64[]": 8,
+          "boolean[]": 1,
+        };
+        const structures: Record<string, string[]> = {
+          "struct:Pose2d": ["x", "y", "heading"],
+          "struct:Translation2d": ["x", "y"],
+          "struct:Rotation2d": ["heading"],
+          "struct:ChassisSpeeds": ["vx", "vy", "omega"],
+        };
+        if (arrays[channel.type]) {
+          const width = arrays[channel.type];
+          if (size % width || size / width > 512)
+            throw new Error(
+              `Invalid or oversized numeric array in ${channel.name}.`,
+            );
+          for (let i = 0; i < size / width; i++) {
+            const at = offset + i * width;
+            if (channel.type === "int64[]") {
+              const n = Number(view.getBigInt64(at, true));
+              if (!Number.isSafeInteger(n)) {
+                warnings.add(
+                  `${channel.name}: imprecise integer array samples were skipped.`,
+                );
+                continue;
+              }
+              derived(String(i), n);
+            } else
+              derived(
+                String(i),
+                channel.type === "double[]"
+                  ? view.getFloat64(at, true)
+                  : channel.type === "float[]"
+                    ? view.getFloat32(at, true)
+                    : bytes[at] !== 0,
+              );
+          }
+        } else if (structures[channel.type]) {
+          const fields = structures[channel.type];
+          if (size !== fields.length * 8)
+            throw new Error(
+              `Invalid ${channel.type} payload in ${channel.name}.`,
+            );
+          fields.forEach((field, i) =>
+            derived(field, view.getFloat64(offset + i * 8, true)),
+          );
+        } else
+          switch (channel.type) {
+            case "boolean":
+              if (size === 1) value = bytes[offset] !== 0;
+              break;
+            case "double":
+              if (size === 8) value = view.getFloat64(offset, true);
+              break;
+            case "float":
+              if (size === 4) value = view.getFloat32(offset, true);
+              break;
+            case "int64":
+              if (size === 8) {
+                const n = view.getBigInt64(offset, true);
+                if (
+                  n >= BigInt(Number.MIN_SAFE_INTEGER) &&
+                  n <= BigInt(Number.MAX_SAFE_INTEGER)
+                )
+                  value = Number(n);
+                else
+                  warnings.add(
+                    `${channel.name}: large integers cannot be represented exactly and were skipped.`,
+                  );
+              }
+              break;
+            case "string":
+            case "json":
+              value = decoder.decode(bytes.subarray(offset, end));
+              break;
+            default:
+              warnings.add(
+                `${channel.type}: decoding is not available yet; entries are listed without samples.`,
+              );
+          }
+        if (value !== undefined) append(channel, value);
+      }
+    }
+    offset = end;
+  }
+  if (minTime === Infinity) minTime = 0;
+  for (const c of channels) {
+    c.samples.sort((a, b) => a.time - b.time);
+    for (const s of c.samples) s.time -= minTime;
+  }
+  return {
+    name,
+    duration: maxTime - minTime,
+    channels,
+    warnings: [...warnings],
+  };
+}
