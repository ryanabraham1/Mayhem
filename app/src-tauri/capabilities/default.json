{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: run the bundled solver sidecar, pick project folders, install app updates",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/mayhem-solver", "sidecar": true, "args": ["serve"] }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/mayhem-solver", "sidecar": true, "args": ["serve"] }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
