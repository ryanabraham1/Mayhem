{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mayhem",
  "version": "0.7.0",
  "identifier": "dev.mayhem.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mayhem",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Time-optimal FRC swerve trajectory generator",
    "longDescription": "Mayhem plans time-optimal, obstacle-aware swerve drive trajectories for FRC robots.",
    "externalBin": [
      "binaries/mayhem-solver"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3OUFERjgxNkI3QzE4N0IKUldSN0dIeHJnZCthMThseXFNNnNYR3g5VEtYYXlid0N5ME5mTngyRVJhVjlnby9hcDBodjJ5V0gK",
      "endpoints": [
        "https://github.com/ryanabraham1/Mayhem/releases/latest/download/latest.json"
      ]
    }
  }
}
